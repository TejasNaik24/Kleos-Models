# ---------------------------------------------------------------------------
# Runtime settings for the Hermes container — PLACEHOLDERS ONLY.
#
#   cp docker/hermes.env.example docker/hermes.env      # hermes.env is gitignored
#   docker run --env-file docker/hermes.env ...
#
# Secret values are deliberately left EMPTY. An empty HERMES_API_KEY makes the
# container refuse to start, which is the point: a placeholder such as
# "<your-key>" left in place would become a real, guessable credential.
#
# Prefer the *_FILE form in production. The value then lives in a mounted
# secret file and does not appear in `docker inspect` or the process listing.
# Set either NAME or NAME_FILE, never both — startup refuses the ambiguity.
# ---------------------------------------------------------------------------

# --- secrets ------------------------------------------------------------------

# Required. Shared secret the KLEOS backend sends as "Authorization: Bearer ...".
# Several keys may be comma-separated, to rotate without downtime.
# Generate with: openssl rand -hex 32
HERMES_API_KEY=
# HERMES_API_KEY_FILE=/run/secrets/hermes_api_key

# Optional. The base model is ungated; a token raises download rate limits.
HF_TOKEN=
# HF_TOKEN_FILE=/run/secrets/hf_token

# --- settings (all optional) ----------------------------------------------------

# Confirm the base commit with the Hub at startup, and fail if it cannot be reached.
# HERMES_REQUIRE_REMOTE_REVISION=1

# After the first successful start, the cache holds the pinned base; this makes
# later starts independent of the Hub. The revision pin still applies offline.
# HF_HUB_OFFLINE=1

# These may only TIGHTEN the limits recorded in the package manifest.
# HERMES_REQUEST_TIMEOUT_SECONDS=120
# HERMES_MAX_INPUT_CHARS=24000

# Pin to one device on a multi-GPU host.
# HERMES_DEVICE_MAP=cuda:0

# Set by the image; override only with a reason.
# HERMES_PORT=8000
# HERMES_PACKAGE_DIR=/models/hermes-v0.0.6
