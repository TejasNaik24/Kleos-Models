# ---------------------------------------------------------------------------
# KLEOS Models environment variables (EXAMPLE)
#
# Copy to `.env` and fill in locally. `.env` is git-ignored and must NEVER be
# committed or uploaded to the Hugging Face Hub.
#
# On Google Colab, prefer Colab Secrets (the key icon in the left sidebar) over
# a .env file. See docs/colab.md.
#
# Every variable below is OPTIONAL. Nothing in this repository requires a
# secret to run the data, validation, splitting, leakage or offline evaluation
# pipelines.
# ---------------------------------------------------------------------------

# Hugging Face access token.
# Needed only to (a) download gated base models, or (b) publish an adapter.
# Create at https://huggingface.co/settings/tokens
# Use a FINE-GRAINED token with the minimum scope you need.
HF_TOKEN=

# Default namespace used by scripts/publish_adapter.py when --repo-id omits one.
HF_DEFAULT_NAMESPACE=

# Where Hugging Face caches downloaded weights. On Colab, pointing this at a
# mounted Drive folder avoids re-downloading after a runtime reset.
# HF_HOME=/content/drive/MyDrive/kleos/hf_cache

# Optional Weights & Biases logging. Disabled by default; training only reports
# to W&B when `training.report_to` includes "wandb" in the config.
WANDB_API_KEY=
WANDB_PROJECT=kleos-models
WANDB_MODE=offline

# Optional: root directory for training outputs. Defaults to ./outputs
# On Colab, set this to a Drive path so checkpoints survive a runtime reset.
# KLEOS_OUTPUT_ROOT=/content/drive/MyDrive/kleos/outputs

# Optional: path to an externally supplied dataset directory produced by the
# PRIVATE kleos-training-data repository. Never point this inside this repo.
# KLEOS_DATASET_PATH=/path/to/private/dataset

# ---------------------------------------------------------------------------
# NEVER put the following in this file or anywhere in this repository:
#   - Supabase service-role keys, anon keys, or database URLs
#   - production API keys of any kind
#   - user access tokens, cookies, or session identifiers
#   - personal contact information
# ---------------------------------------------------------------------------
